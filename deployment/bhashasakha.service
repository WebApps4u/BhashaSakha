[Unit]
Description=BhashaSakha Offline Voice Translation
After=network.target sound.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=babhan
Group=audio
WorkingDirectory=/home/babhan/Documents/Live/bhashasakha

# Fully offline kiosk: never let model libraries call out to the internet
# (avoids multi-second startup timeouts when no network is present)
Environment="HF_HUB_OFFLINE=1"
Environment="TRANSFORMERS_OFFLINE=1"

ExecStart=/home/babhan/Documents/Live/bhashasakha/.venv/bin/python ui/server.py

Restart=on-failure
RestartSec=10

# Memory guard only — the kiosk should use ALL CPU cores
MemoryMax=8G

# Logging via journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bhashasakha

[Install]
WantedBy=multi-user.target
