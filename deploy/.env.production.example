# Build-time (used when building the Docker image)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Runtime (used by the API server container)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

ADMIN_BOOTSTRAP_TOKEN=

GOOGLE_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL_TRANSLATE=gemini-2.5-flash

CORS_ORIGIN=https://your-domain.com

# TTS
SERVE_FRONTEND=true
ENABLE_TTS_STORAGE_CACHE=true
TTS_CACHE_BUCKET=tts-cache
TTS_CACHE_VERSION=1

